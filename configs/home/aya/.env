export EDITOR=msedit
export LANG=zh_CN.UTF-8
export PATH=/home/aya/.local/bin:/home/aya/.go/bin/:$PATH
export EGET_GITHUB_TOKEN=github_pat_xxx
export GITHUB_TOKEN=github_pat_xxx

# 设置 Android SDK 根目录
export ANDROID_HOME=$HOME/Android/Sdk
export ANDROID_SDK_ROOT=$ANDROID_HOME

# 将 Platform Tools 和 Build Tools 添加到 PATH
export PATH=$PATH:$ANDROID_HOME/cmdline-tools/latest/bin
export PATH=$PATH:$ANDROID_HOME/platform-tools
export PATH=$PATH:$ANDROID_HOME/build-tools/34.0.0
export JAVA_HOME="$HOME/.local/share/jdks/jdk-17.0.20.1+1"